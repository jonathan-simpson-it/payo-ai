# MongoDB connection string for the waitlist (Hong Kong region recommended, e.g. ap-east-1)
MONGO_URI=

# Password for the internal waitlist admin view (entered on the landing page with an admin email)
WAITLIST_ADMIN_PASSWORD=

# DeepSeek API for natural-language workflow authoring (server-side only; never exposed to the client).
# Put the real key in .env.local. If unset, the Create screen falls back to template start.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
